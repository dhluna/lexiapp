# Cuentas y sincronización. Sin estas variables, Lexi funciona sin cuentas.
# Son las mismas que la web (Supabase › Project Settings › API), con el prefijo EXPO_PUBLIC_.
# Copia este archivo a .env.local.
EXPO_PUBLIC_SUPABASE_URL=
# Clave pública (publishable / anon). Nunca pongas aquí la clave service_role.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
