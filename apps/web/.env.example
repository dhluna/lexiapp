# Cuentas y sincronización (Fase 3). Sin estas variables, Lexi funciona sin cuentas.
# Valores en Supabase › Project Settings › API. Copia este archivo a .env.local.
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (publishable / anon). Nunca pongas aquí la clave service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Recordatorio diario (opcional, docs/15-recordatorios.md). `npm run vapid` crea las claves.
# Con la clave pública, Ajustes muestra el recordatorio. Las demás solo hacen falta en Vercel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# REMINDERS_SECRET=
# Solo servidor (nunca NEXT_PUBLIC_): Supabase › Project Settings › API Keys › Secret keys.
# SUPABASE_SECRET_KEY=
