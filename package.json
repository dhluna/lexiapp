{
  "name": "lexiapp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lexi/web",
    "build": "npm run build -w @lexi/web",
    "start": "npm run start -w @lexi/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:sql": "node scripts/test-sql.mjs"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "expo-router": "~58.0.23",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
