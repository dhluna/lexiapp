{
  "name": "lexiapp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lexi/web",
    "build": "npm run build -w @lexi/web",
    "start": "npm run start -w @lexi/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:sql": "node scripts/test-sql.mjs",
    "audio": "tsx scripts/generate-audio.ts",
    "qr": "node scripts/generate-qr.mjs"
  },
  "devDependencies": {
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15"
  }
}
