{
  "compilerOptions": {
    "target": "ES2022",
    // Sin "dom": el núcleo no puede usar APIs del navegador (se compila también para React Native).
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
